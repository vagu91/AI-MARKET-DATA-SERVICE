{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "service_telemetry_event.schema.json",
  "title": "Market Data Service telemetry event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_name",
    "occurred_at",
    "trace_id",
    "span_id",
    "parent_span_id",
    "correlation_id",
    "parent_run_id",
    "child_job_id",
    "child_run_id",
    "invocation_id",
    "tool_call_id",
    "source_id",
    "verification_id",
    "claim_id",
    "snapshot_id",
    "outbox_event_id",
    "decision_summary",
    "evidence_ids",
    "confidence",
    "rejection_reasons",
    "stop_reason",
    "input_schema_version",
    "output_schema_version",
    "payload_hash",
    "redacted_error"
  ],
  "properties": {
    "event_name": {"type": "string", "maxLength": 100},
    "occurred_at": {"type": "string", "format": "date-time"},
    "trace_id": {"type": ["string", "null"], "maxLength": 64},
    "span_id": {"type": ["string", "null"], "maxLength": 32},
    "parent_span_id": {"type": ["string", "null"], "maxLength": 32},
    "correlation_id": {"type": ["string", "null"], "maxLength": 160},
    "parent_run_id": {"type": ["string", "null"], "maxLength": 120},
    "child_job_id": {"type": ["string", "null"], "maxLength": 120},
    "child_run_id": {"type": ["string", "null"], "maxLength": 120},
    "invocation_id": {"type": ["string", "null"], "maxLength": 160},
    "tool_call_id": {"type": ["string", "null"], "maxLength": 160},
    "source_id": {"type": ["string", "null"], "maxLength": 160},
    "verification_id": {"type": ["string", "null"], "maxLength": 160},
    "claim_id": {"type": ["string", "null"], "maxLength": 160},
    "snapshot_id": {"type": ["string", "null"], "maxLength": 160},
    "outbox_event_id": {"type": ["string", "null"], "maxLength": 160},
    "decision_summary": {"type": ["string", "null"], "maxLength": 1000},
    "evidence_ids": {
      "type": "array",
      "items": {"type": "string", "maxLength": 160},
      "maxItems": 100
    },
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "rejection_reasons": {
      "type": "array",
      "items": {"type": "string", "maxLength": 300},
      "maxItems": 100
    },
    "stop_reason": {"type": ["string", "null"], "maxLength": 300},
    "input_schema_version": {"type": ["string", "null"], "maxLength": 80},
    "output_schema_version": {"type": ["string", "null"], "maxLength": 80},
    "payload_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "redacted_error": {"type": ["string", "null"], "maxLength": 1000}
  }
}
